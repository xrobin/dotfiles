#!/usr/bin/env bash
#
# bootstrap installs things.

DOTFILES_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && cd .. && pwd )"

set -e

echo ''

info () {
  printf "  [ \033[00;34m..\033[0m ] $1"
}

user () {
  printf "\r  [ \033[0;33m?\033[0m ] $1 "
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

soft_fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
}

fail () {
  soft_fail "$1"
  echo ''
  exit
}

try_exec () {
    cmd=$1
    error_msg=$2
    set +e
    e_out=$(eval $1 2>&1 )
    e_success=$?
    set -e
    if [[ $e_success == 0 ]]; then
        : # continue
    else
        soft_fail "$error_msg ($cmd). Full output:"
        echo "$e_out"
        exit $e_success
    fi
}

setup_gitconfig () {
  if ! [ -f git/gitconfig.symlink ]
  then
    info 'setup gitconfig'

    git_credential='cache'
    if [ "$(uname -s)" == "Darwin" ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your github author name?'
    read -e git_authorname
    user ' - What is your github author email?'
    read -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" git/gitconfig.symlink.example > git/gitconfig.symlink

    success 'gitconfig'
  fi
}

link_files () {
  ln -s $1 $2
  success "linked $1 to $2"
}

try_install_file() {
    src=$1
    dst=$2

    if [ -f $dst ] || [ -d $dst ]
    then

      overwrite=false
      backup=false
      skip=false

      if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
      then
        user "File already exists: `basename ${dst}`, what do you want to do? [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac
      fi

      if [ "$overwrite" == "true" ] || [ "$overwrite_all" == "true" ]
      then
        rm -rf $dst
        success "removed $dst"
      fi

      if [ "$backup" == "true" ] || [ "$backup_all" == "true" ]
      then
        mv $dst $dst\.backup
        success "moved $dst to $dst.backup"
      fi

      if [ "$skip" == "false" ] && [ "$skip_all" == "false" ]
      then
        link_files $src $dst
      else
        success "skipped $src"
      fi

    elif [ -h "$dst" -a ! -e "$dst"  ] ; then
      rm "$dst"
      link_files $src $dst

    else
      link_files $src $dst
    fi
    
}

install_dotfiles () {
  info 'installing dotfiles'

  overwrite_all=false
  backup_all=false
  skip_all=false

  for source in `find $DOTFILES_ROOT -name \*.symlink`
  do
      if [[ "$source" =~ ^.*\.mac\.symlink$ && `uname` != "Darwin" ]]; then
        success "skipped $source"
        continue
      fi
      if [[ "$source" =~ ^.*\.linux\.symlink$ && `uname` != "Linux" ]]; then
        success "skipped $source"
        continue
      fi
      # Compute destination relative to the topic directory, supporting nested paths.
      # e.g. base/cursor/rules.symlink -> cursor/rules -> ~/.cursor/rules
      # For flat entries (base/bashrc.symlink -> bashrc -> ~/.bashrc) this is equivalent
      # to the old basename approach.
      rel_path="${source#$DOTFILES_ROOT/*/}"
      rel_path="${rel_path%.*}"
      dest="$HOME/.$rel_path"
      mkdir -p "$(dirname "$dest")"
      try_install_file "$source" "$dest"
  done
}

docopts_release_os_arch () {
    case "$OSTYPE" in
        darwin*) DOCOPTS_OS_URL=darwin ;;
        linux*)  DOCOPTS_OS_URL=linux ;;
        *)       return 1 ;;
    esac
    ARCH=$(uname -m)
    case $ARCH in
        x86_64) DOCOPTS_ARCH_BIN=amd64 ;;
        i*86)   DOCOPTS_ARCH_BIN=386 ;;
        arm*)   DOCOPTS_ARCH_BIN=arm ;;
        *)      return 1 ;;
    esac
    return 0
}

install_docopts () {
    info 'installing docopts'

    if hash docopts 2>/dev/null && docopts -h >/dev/null 2>&1; then
        success 'skipped docopts'
        return
    fi

    DOCOPTS_RELEASE=v0.6.4-with-no-mangle-double-dash
    DOCOPTS_BASE_URL=https://github.com/docopt/docopts/releases/download

    if ! docopts_release_os_arch; then
        fail "unsupported OS/arch for docopts binary (OSTYPE=$OSTYPE, arch=$(uname -m))"
    fi

    if [ ! -e "$HOME/bin" ]; then
        try_exec "mkdir -p $HOME/bin" "error creating ~/bin"
    fi

    DOCOPTS_DOWNLOAD=docopts_${DOCOPTS_OS_URL}_${DOCOPTS_ARCH_BIN}
    DOCOPTS_URL="$DOCOPTS_BASE_URL/$DOCOPTS_RELEASE/$DOCOPTS_DOWNLOAD"
    DOCOPTS_DIR=$(mktemp -d)
    trap 'rm -rf "$DOCOPTS_DIR"' RETURN

    if ! hash wget 2>/dev/null; then
        fail 'wget required to download docopts binary'
    fi

    try_exec "wget -q -O \"$DOCOPTS_DIR/$DOCOPTS_DOWNLOAD\" \"$DOCOPTS_URL\"" "error downloading docopts from $DOCOPTS_URL"
    try_exec "wget -q -O \"$DOCOPTS_DIR/sha256sum.txt\" \"$DOCOPTS_BASE_URL/$DOCOPTS_RELEASE/sha256sum.txt\"" "error downloading docopts sha256sum"

    if [ "$(uname -s)" = "Darwin" ]; then
        sha256sum() { openssl sha256 "$2" | awk '{print $2}'; }
    fi
    (
        cd "$DOCOPTS_DIR"
        sha256sum --ignore-missing -c sha256sum.txt
    )

    install -m 755 "$DOCOPTS_DIR/$DOCOPTS_DOWNLOAD" "$HOME/bin/docopts"
    success 'docopts installed successfully'
}

install_trash () {
    info 'installing trash-cli'

    if hash trash 2>/dev/null; then
        success 'skipped trash-cli'
        return
    fi

    if [ "$(uname -s)" = "Darwin" ]; then
        try_exec "brew install trash-cli" "error installing trash-cli with brew"
    else
        user 'Install trash-cli via [a]pt+pipx (sudo) or [p]ip+pipx (no sudo)? '
        read -n 1 trash_method
        echo
        case "$trash_method" in
            a|A)
                try_exec "sudo apt install -y pipx" "error installing pipx with apt"
                ;;
            p|P)
                if ! python3 -m pip --version >/dev/null 2>&1; then
                    fail 'pip not available — load a Python module (e.g. ml Python/...) or use the apt path'
                fi
                try_exec "python3 -m pip install --user pipx" "error installing pipx with pip"
                export PATH="$HOME/.local/bin:$PATH"
                ;;
            *)
                fail 'unknown choice'
                ;;
        esac
        if ! hash pipx 2>/dev/null; then
            export PATH="$HOME/.local/bin:$PATH"
        fi
        try_exec "pipx ensurepath" "error running pipx ensurepath"
        try_exec "pipx install trash-cli" "error installing trash-cli with pipx"
    fi
    success 'trash-cli installed successfully'
}

# setup_gitconfig
install_dotfiles
install_docopts
install_trash
# install_thefuck

# If we're on a Mac, let's install and setup homebrew.
